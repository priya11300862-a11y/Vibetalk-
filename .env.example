# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional - connects to live backend if provided)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# MINIMOTH MOBILE PHONE OTP CONFIGURATION
# Sign up at https://minimoth.dev to get your API key.
# Supports sandbox testing (mm_test_...) and live production (mm_live_...).
# Never share or expose this key on the client/frontend.
MINIMOTH_API_KEY="mm_test_your_minimoth_api_key_here"

# FIREBASE PHONE AUTHENTICATION CONFIGURATION
# Required for real Firebase Phone SMS OTP & reCAPTCHA verification
VITE_FIREBASE_API_KEY="AIzaSyExampleKey"
VITE_FIREBASE_AUTH_DOMAIN="vibetalk-social.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="vibetalk-social"
VITE_FIREBASE_STORAGE_BUCKET="vibetalk-social.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

